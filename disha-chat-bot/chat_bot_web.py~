    number = ["জিরো", "ওয়ান", "টু", "থ্রি", "ফোর", "ফাইভ", "সিক্স", "সেভেন", "এইট", "নাইন"]
    st = string.split(" ")
    wr = ""

    for i, w in enumerate(st):
        for j, n in enumerate(number):
            if w == n:
                if st[i - 1] == "ডাবল" or st[i - 1] == "ডবল":
                    wr = wr + str(j)
                if st[i - 1] == "ট্রিপল":
                    wr = wr + str(j) + str(j)
                wr = wr + str(j)

    if len(wr) > 1:
        return wr
    else:
        return string

